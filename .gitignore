# Agente de impresión térmica — el código fuente se sube como respaldo;
# lo generado/local a cada PC no (se reconstruye con "npm run build").
print-agent/node_modules/
print-agent/dist/
print-agent/config.json
print-agent/agente.lock
print-agent/agente.log
print-agent-test/
node_modules/

# Variables de entorno para docker-compose
.env

# Dumps de base de datos (no subir datos/backups al repo)
bd/

# Archivos subidos por usuarios (imágenes de productos, logo, etc.)
backend/uploads/*
!backend/uploads/.gitkeep

# Documentación de la API de Personas (registro civil) — contiene credenciales
# de ejemplo y URLs de un servicio de terceros, no se sube al repo.
api_personas/

# Archivos .md: documentación de trabajo/notas, no se sube al repo. Los .md
# que ya estaban commiteados antes de esta regla (specs, planes) no se ven
# afectados — esto solo aplica a archivos nuevos.
*.md

# Workspace de trabajo de Superpowers (ledgers, briefs, reportes) — scratch local.
.superpowers/

# Artefactos de sesiones de prueba con Playwright MCP (snapshots .yml, logs
# de consola) — se generan al verificar features en el navegador, no son
# parte del producto.
.playwright-mcp/

# Simulador de la app de pedidos externa — herramienta de pruebas local, no
# es parte del producto.
frontend/public/simulador-app-externa.html
# Un .env por restaurante en el VPS (contraseñas y secretos) — ver deploy.sh.
instancias/
