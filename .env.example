# Referencia de las variables de UN restaurante. En el VPS no se copia a mano:
# deploy/nuevo-restaurante.sh genera instancias/<nombre>.env con secretos
# aleatorios y el siguiente puerto libre.

# Puerto en el host (127.0.0.1) del contenedor frontend. Distinto por restaurante.
FRONTEND_PORT=8090

DB_NAME=menu_demo
DB_USER=app
DB_PASS=cambia_esta_password
DB_ROOT_PASS=cambia_esta_password_root

JWT_SECRET=cambia_este_secreto_en_produccion
JWT_REFRESH_SECRET=cambia_este_refresh_secreto
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Dominio de ESTE restaurante, sin barra final. El backend lo usa para armar
# la URL de las imágenes subidas: si apunta a otro dominio, se ven rotas.
CORS_ORIGIN=https://menu.rusoft.dev
PUBLIC_API_URL=https://menu.rusoft.dev

# Solo en la instalación nueva: el backend pone este email y contraseña al
# admin (pide cambiarla al entrar) y el nombre a la sucursal y al negocio.
ADMIN_EMAIL=admin@rusoft.dev
ADMIN_PASSWORD=cambia_esta_contrasena
NOMBRE_NEGOCIO=Restaurante Demo

CODEPAY_SANDBOX=true
CODEPAY_API_URL=https://payapi.codewave.com.bo/api
CODEPAY_PUBLIC_KEY=
CODEPAY_SECRET_KEY=
CODEPAY_NOTIFICATION_SECRET=
CODEPAY_SANDBOX_PUBLIC_KEY=
CODEPAY_SANDBOX_SECRET_KEY=
