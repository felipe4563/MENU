PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurante_db
DB_USER=root
DB_PASS=
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_REFRESH_SECRET=cambia_este_refresh_secreto
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# URL pública por la que se accede a este backend (sin barra final) — se usa
# para armar URLs absolutas de imágenes (ej. productos) en las respuestas.
PUBLIC_API_URL=http://localhost:3001
ADMIN_PASSWORD=cambia_esta_contrasena_en_produccion
CODEPAY_SANDBOX=true
CODEPAY_API_URL=https://payapi.codewave.com.bo/api
CODEPAY_PUBLIC_KEY=
CODEPAY_SECRET_KEY=
CODEPAY_NOTIFICATION_SECRET=
CODEPAY_SANDBOX_PUBLIC_KEY=
CODEPAY_SANDBOX_SECRET_KEY=
PERSONAS_API_URL=https://perapi.codewave.com.bo
PERSONAS_API_USERNAME=
PERSONAS_API_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@codewave.com.bo

# Llave para cifrar en la base los datos sensibles (cuenta y credenciales del
# banco). Si no se define se usa JWT_SECRET. No la cambies después de cargar
# esos datos: habría que volver a cargarlos.
CONFIG_SECRET=

# Banco Económico (QR Connect). Si BANECO_USUARIO tiene valor, se usan estos
# datos y nadie puede verlos ni cambiarlos desde la app. Si se deja vacío, el
# dueño los carga en Ajustes › Cobro con QR (se guardan cifrados).
BANECO_URL=https://apimktdesa.baneco.com.bo/ApiGateway
BANECO_USUARIO=
BANECO_PASSWORD=
BANECO_AES_KEY=
BANECO_CUENTA=
BANECO_SUCURSAL=

# Clave del agente de impresión. Si se completa, el servidor solo acepta
# agentes que la tengan en su config.json ("clave_agente"). Vacía: se aceptan
# agentes sin clave (los ya instalados), pero cualquiera con la URL podría
# escuchar los pedidos en vivo.
AGENTE_IMPRESION_CLAVE=
